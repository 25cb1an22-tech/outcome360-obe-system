# Firebase config — copy to `.env` and fill in real values to enable live Firebase.
# When these are empty, OUTCOME 360 runs in MOCK mode (localStorage-backed).
# Every screen still works for demo/presentation purposes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini AI — when empty, AI features fall back to a data-grounded offline analyzer.
VITE_GEMINI_API_KEY=
